{
  "name": "my-lovely-home",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "type": "module",
  "description": "A home in the browser — Three.js spatial showcase",
  "scripts": {
    "dev": "next dev -p 5181",
    "build": "node scripts/check-public.mjs && next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/test/public-model.test.mjs",
    "check:public": "node scripts/check-public.mjs --built",
    "format:check": "prettier --check --ignore-unknown src scripts \"*.{mjs,cjs}\" package.json tsconfig.json",
    "verify": "pnpm test && pnpm build && pnpm typecheck && pnpm check:public && pnpm format:check"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^12.0.0",
    "minisearch": "^7.2.0",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "prettier": "3.9.10",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
